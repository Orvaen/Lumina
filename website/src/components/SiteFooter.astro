---
// The site footer: a band closing the page, in two registers. Shortcuts into
// the documentation and the repository on top; the project's own documents —
// licence, how to contribute, where to ask — and the small print below.
//
// The sidebar already carries the navigation, so nothing here duplicates it.
// The lower row points at the project pages the generator builds from the
// repository's own documents, so the reader stays on the site and in their
// language. There is no code of conduct and no terms page to link to.
//
// Injected by the PageFrame override so it sits below the whole page.
import { existsSync, readFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';

import { Icon } from '@astrojs/starlight/components';

import {
  ABOUT,
  ABOUT_DIR,
  GUIDES,
  GUIDE_DIR,
  PROJECT,
  PROJECT_DIR,
  REFERENCE_DIR,
  REPO,
  labelOf,
} from '../../scripts/lib/structure.mjs';

const locale = Astro.locals.starlightRoute?.locale === 'fr' ? 'fr' : 'en';
// BASE_URL is Astro's view of the configured base; it always ends in a slash.
const site = import.meta.env.BASE_URL.replace(/\/$/, '');
const base = locale === 'en' ? site : `${site}/${locale}`;

// Read straight from the header, so the version in the footer cannot drift
// away from the version in the library. Walk up from the working directory
// rather than from import.meta.url, which points into the bundle at build time.
function findHeader() {
  let dir = resolve(process.cwd());
  for (let i = 0; i < 6; i++) {
    const candidate = join(dir, 'include', 'Lumina', 'lumina.h');
    if (existsSync(candidate)) return candidate;
    const parent = dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  throw new Error('include/Lumina/lumina.h not found above ' + process.cwd());
}

const header = readFileSync(findHeader(), 'utf8');
const versionPart = (name: string) =>
  header.match(new RegExp(`#define\\s+LUM_VERSION_${name}\\s+(\\d+)`))?.[1] ?? '0';
const revision = versionPart('REVISION');
const version = [versionPart('MAJOR'), versionPart('MINOR')]
  .concat(revision === '0' ? [] : [revision])
  .join('.');

const t = {
  en: {
    nav: 'Lumina',
    project: 'Project',
    allFunctions: 'All functions',
    constants: 'Constants',
    source: 'Source on GitHub',
    licence: 'zlib/libpng licence',
    fork: 'an altered version of GLFW 3.4',
  },
  fr: {
    nav: 'Lumina',
    project: 'Projet',
    allFunctions: 'Toutes les fonctions',
    constants: 'Constantes',
    source: 'Sources sur GitHub',
    licence: 'licence zlib/libpng',
    fork: 'version modifiée de GLFW 3.4',
  },
}[locale];

const guide = (slug: string) => {
  const page = GUIDES.find((g) => g.slug === slug)!;
  return { label: labelOf(page, locale), href: `${base}/${GUIDE_DIR}/${page.slug}/` };
};
const releaseNotes = ABOUT.find((p) => p.slug === 'release-notes')!;

const links = [
  guide('first-window'),
  { label: t.allFunctions, href: `${base}/${REFERENCE_DIR}/` },
  { label: t.constants, href: `${base}/${REFERENCE_DIR}/constants/` },
  { label: labelOf(releaseNotes, locale), href: `${base}/${ABOUT_DIR}/${releaseNotes.slug}/` },
];

// The project's own documents, as the pages the generator builds from them.
// Taken from the same list the sidebar is built from, so a document added
// there appears here without touching this file.
const projectLinks = PROJECT.map((page) => ({
  label: labelOf(page, locale),
  href: `${base}/${PROJECT_DIR}/${page.slug}/`,
}));

const year = new Date().getFullYear();
---

<footer class="lum-footer not-content">
  <div class="lum-footer__top">
    <nav class="lum-footer__links" aria-label={t.nav}>
      {links.map((entry) => <a href={entry.href}>{entry.label}</a>)}
    </nav>

    <a
      class="lum-footer__icon"
      href={REPO}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={t.source}
    >
      <Icon name="github" size="1.25rem" />
    </a>
  </div>

  <div class="lum-footer__bottom">
    <nav class="lum-footer__meta" aria-label={t.project}>
      {projectLinks.map((entry) => <a href={entry.href}>{entry.label}</a>)}
    </nav>

    <p class="lum-footer__legal">
      &copy; {year} Lumina {version} &middot; {t.licence} &middot; {t.fork}
    </p>
  </div>
</footer>
